#
# Environment variables for the Potluck API
#
# IMPORTANT: Do not commit real secrets.
# This is only a placeholder to document required variables.
#

# Required: Neon Postgres connection string
# Example format (replace placeholders, keep ssl if using Neon):
# postgres://YOUR_USER:YOUR_PASSWORD@YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require
DATABASE_URL=

# Optional: configure CORS origin for the API
# CORS_ORIGIN=http://localhost:5173

# Optional: admin token required for modifying signups (PUT/DELETE)
# ADMIN_TOKEN=replace-with-a-strong-random-string

